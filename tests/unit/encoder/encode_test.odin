package encoder_test

// Checks rv64.encode against llvm-mc encodings (cases.odin, generated by
// gen_cases.py). Run:
//
//   odin test tests/unit/encoder -out:build/encoder_test
//
// Operand convention per instruction class (registers are numbers 0-31, in
// the integer or FP file depending on the instruction):
//
//   R-type, FP 3-operand     rd, rs1, rs2
//   I-type ALU, jalr, loads  rd, rs1, imm (load: imm(rs1))
//   shifts by immediate      rd, rs1, imm = shift amount
//   stores                   rs2 = value, rs1 = base, imm = offset
//   branches                 rs1, rs2, imm = byte offset (even)
//   lui, auipc               rd, imm = the 20-bit field (0 to 0xFFFFF)
//   jal                      rd, imm = byte offset (even)
//   FP unary (fsqrt, fcvt)   rd, rs1 (rs2 = 0; the encoder fills in the
//                            fixed rs2 field fcvt uses as a sub-opcode)
//   rm                       rounding mode for FP arithmetic and fcvt:
//                            0 rne, 1 rtz, 2 rdn, 3 rup, 4 rmm, 7 dyn;
//                            0 for instructions without an rm field

import "core:fmt"
import "core:log"
import "core:strings"
import "core:testing"

import rv64 "../../../src/target/rv64"

Case :: struct {
	op:   rv64.Op,
	rd:   u8,
	rs1:  u8,
	rs2:  u8,
	imm:  i64,
	rm:   u8,
	want: u32,
	text: string, // the assembly llvm-mc encoded
}

// The only place that knows the encoder's signature.
encode_case :: proc(c: Case) -> u32 {
	return rv64.encode(c.op, c.rd, c.rs1, c.rs2, c.imm, c.rm)
}

MAX_REPORTED :: 40

@(test)
test_encode :: proc(t: ^testing.T) {
	failed := 0
	failed_ops: map[rv64.Op]int
	defer delete(failed_ops)
	for c in CASES {
		got := encode_case(c)
		if got == c.want {
			continue
		}
		failed += 1
		failed_ops[c.op] += 1
		if failed <= MAX_REPORTED {
			log.warnf("%s\n    want %s\n    got  %s\n    differs in: %s",
				c.text, fields(c.want), fields(got), diff_fields(c.want, got))
		}
	}
	if failed > 0 {
		sb := strings.builder_make(context.temp_allocator)
		for op, n in failed_ops {
			fmt.sbprintf(&sb, " %v(%d)", op, n)
		}
		log.warnf("failing instructions:%s", strings.to_string(sb))
	}
	testing.expectf(t, failed == 0, "%d of %d encodings wrong", failed, len(CASES))
}

// Every instruction the encoder knows must have test cases, so adding an op
// to rv64.Op without adding it to gen_cases.py fails here.
@(test)
test_every_op_has_cases :: proc(t: ^testing.T) {
	seen: [rv64.Op]bool
	for c in CASES {
		seen[c.op] = true
	}
	for op in rv64.Op {
		testing.expectf(t, seen[op], "no test cases for %v: add it to gen_cases.py and regenerate", op)
	}
}

// The word split at the R-type field boundaries:
// funct7 | rs2 | rs1 | funct3 | rd | opcode.
fields :: proc(w: u32) -> string {
	return fmt.tprintf("%07b %05b %05b %03b %05b %07b  (0x%08x)",
		w >> 25, (w >> 20) & 0x1f, (w >> 15) & 0x1f, (w >> 12) & 7, (w >> 7) & 0x1f, w & 0x7f, w)
}

// Names the differing bit ranges. The names are the R-type fields; in the
// I, S, B, U and J formats some of these bits hold immediate pieces.
diff_fields :: proc(want, got: u32) -> string {
	FIELDS := [?]struct {
		name:       string,
		shift, len: u32,
	}{
		{"[6:0] opcode", 0, 7}, {"[11:7] rd", 7, 5}, {"[14:12] funct3/rm", 12, 3},
		{"[19:15] rs1", 15, 5}, {"[24:20] rs2", 20, 5}, {"[31:25] funct7", 25, 7},
	}
	sb := strings.builder_make(context.temp_allocator)
	x := want ~ got
	for fld in FIELDS {
		if (x >> fld.shift) & ((1 << fld.len) - 1) != 0 {
			if strings.builder_len(sb) > 0 {
				strings.write_string(&sb, ", ")
			}
			strings.write_string(&sb, fld.name)
		}
	}
	return strings.to_string(sb)
}
